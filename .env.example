# Create a bot with @BotFather, then paste its token here.
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Send a message to your bot, then run:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# Poll every 20 minutes by default.
POLL_INTERVAL_MINUTES=20

# Send automatic usage notifications at most once per hour.
NOTIFICATION_MIN_INTERVAL_MINUTES=60
TZ=Asia/Seoul

# Optional: when both five-hour and weekly limits are exactly 100%, send one tiny
# Codex prompt so their real reset windows are initialized. The cooldown prevents
# repeats while the API is still reflecting the request.
PRIME_FULL_USAGE=false
FULL_USAGE_PRIME_COOLDOWN_MINUTES=20

# Optional command override. The Docker image already includes codex.
CODEX_COMMAND=codex

# JSON-RPC and Telegram request timeout.
REQUEST_TIMEOUT_SECONDS=30

# Telegram long polling; no inbound port or web server is required.
TELEGRAM_LONG_POLL_SECONDS=50
