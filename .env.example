# Create a bot with @BotFather, then paste its token here.
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Send a message to your bot, then run:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# Poll every 90 minutes by default.
POLL_INTERVAL_MINUTES=90
TZ=Asia/Seoul

# always: send a report after every successful poll
# changes: send only when the normalized usage state changes
NOTIFY_MODE=always

# Optional command override. The Docker image already includes codex.
CODEX_COMMAND=codex

# JSON-RPC and Telegram request timeout.
REQUEST_TIMEOUT_SECONDS=30
